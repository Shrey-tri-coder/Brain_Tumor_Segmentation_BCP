import os
import numpy as np
import nibabel as nib
import cv2
import matplotlib.pyplot as plt

import tensorflow as tf
from tensorflow.keras import layers, models, backend as K
from sklearn.model_selection import train_test_split


# Global configuration
DATA_DIR = r"C:\Users\Shreyansh Tripathi\Downloads\archive1"
MODALITY = "flair"
IMG_SIZE = 128
SLICE_START = 20
SLICE_END = 140
BATCH_SIZE = 16
EPOCHS = 10


# Utility functions
def normalize(img):
    img = img.astype(np.float32)
    img -= img.min()
    if img.max() != 0:
        img /= img.max()
    return img


def load_nifti(path):
    return nib.load(path).get_fdata()


# Convert volume to slices
def extract_slices(volume, mask):
    images, masks = [], []

    depth = volume.shape[2]
    start = min(SLICE_START, depth - 1)
    end = min(SLICE_END, depth)

    for i in range(start, end):
        img_slice = volume[:, :, i]
        mask_slice = mask[:, :, i]

        img_slice = normalize(img_slice)
        img_slice = cv2.resize(img_slice, (IMG_SIZE, IMG_SIZE))

        mask_slice = cv2.resize(mask_slice, (IMG_SIZE, IMG_SIZE))
        mask_slice = (mask_slice > 0).astype(np.float32)

        images.append(img_slice)
        masks.append(mask_slice)

    return images, masks


# Dataset preparation
def prepare_dataset(data_dir):
    X, Y = [], []

    patients = sorted(os.listdir(data_dir))
    print(f"Found {len(patients)} patient folders")

    for patient in patients:
        patient_path = os.path.join(data_dir, patient)
        if not os.path.isdir(patient_path):
            continue

        img_path = os.path.join(
            patient_path, f"{patient}_{MODALITY}.nii.gz"
        )
        mask_path = os.path.join(
            patient_path, f"{patient}_seg.nii.gz"
        )

        if not os.path.exists(img_path) or not os.path.exists(mask_path):
            continue

        volume = load_nifti(img_path)
        mask = load_nifti(mask_path)

        imgs, masks = extract_slices(volume, mask)
        X.extend(imgs)
        Y.extend(masks)

    X = np.array(X)[..., np.newaxis]
    Y = np.array(Y)[..., np.newaxis]

    print(f"Final dataset shape X {X.shape} Y {Y.shape}")
    return X, Y


# Metrics
def dice_coef(y_true, y_pred, smooth=1):
    y_true = K.flatten(y_true)
    y_pred = K.flatten(y_pred)
    intersection = K.sum(y_true * y_pred)
    return (2. * intersection + smooth) / (
        K.sum(y_true) + K.sum(y_pred) + smooth
    )


def dice_loss(y_true, y_pred):
    return 1 - dice_coef(y_true, y_pred)


def iou(y_true, y_pred, smooth=1):
    y_true = K.flatten(y_true)
    y_pred = K.flatten(y_pred)
    intersection = K.sum(y_true * y_pred)
    union = K.sum(y_true) + K.sum(y_pred) - intersection
    return (intersection + smooth) / (union + smooth)


# U Net model
def build_unet(input_shape=(IMG_SIZE, IMG_SIZE, 1)):
    inputs = layers.Input(input_shape)

    c1 = layers.Conv2D(64, 3, activation="relu", padding="same")(inputs)
    c1 = layers.Conv2D(64, 3, activation="relu", padding="same")(c1)
    p1 = layers.MaxPooling2D()(c1)

    c2 = layers.Conv2D(128, 3, activation="relu", padding="same")(p1)
    c2 = layers.Conv2D(128, 3, activation="relu", padding="same")(c2)
    p2 = layers.MaxPooling2D()(c2)

    c3 = layers.Conv2D(256, 3, activation="relu", padding="same")(p2)
    c3 = layers.Conv2D(256, 3, activation="relu", padding="same")(c3)
    p3 = layers.MaxPooling2D()(c3)

    b = layers.Conv2D(512, 3, activation="relu", padding="same")(p3)
    b = layers.Conv2D(512, 3, activation="relu", padding="same")(b)

    u1 = layers.UpSampling2D()(b)
    u1 = layers.concatenate([u1, c3])
    c4 = layers.Conv2D(256, 3, activation="relu", padding="same")(u1)

    u2 = layers.UpSampling2D()(c4)
    u2 = layers.concatenate([u2, c2])
    c5 = layers.Conv2D(128, 3, activation="relu", padding="same")(u2)

    u3 = layers.UpSampling2D()(c5)
    u3 = layers.concatenate([u3, c1])
    c6 = layers.Conv2D(64, 3, activation="relu", padding="same")(u3)

    outputs = layers.Conv2D(1, 1, activation="sigmoid")(c6)

    return models.Model(inputs, outputs)


# Visualization
def visualize_prediction(model, X, Y, idx):
    pred = model.predict(X[idx:idx+1])[0, :, :, 0]

    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.title("MRI Slice")
    plt.imshow(X[idx, :, :, 0], cmap="gray")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.title("Ground Truth")
    plt.imshow(Y[idx, :, :, 0], cmap="gray")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.title("Prediction")
    plt.imshow(pred, cmap="gray")
    plt.axis("off")

    plt.show()


# Main execution
def main():
    X, Y = prepare_dataset(DATA_DIR)

    X_train, X_val, Y_train, Y_val = train_test_split(
        X, Y, test_size=0.2, random_state=42
    )

    model = build_unet()
    model.compile(
        optimizer="adam",
        loss=dice_loss,
        metrics=[dice_coef, iou]
    )

    model.fit(
        X_train, Y_train,
        validation_data=(X_val, Y_val),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE
    )

    model.evaluate(X_val, Y_val)
    visualize_prediction(model, X_val, Y_val, idx=10)


# Entry point
if __name__ == "__main__":
    main()
