import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
import numpy as np
import matplotlib.pyplot as plt

class RandomMRIDataset(Dataset):
    def __init__(self, n=100):
        self.n = n

    def __len__(self):
        return self.n

    def __getitem__(self, i):
        img = torch.randn(1, 64, 64)
        msk = (torch.randn(1, 64, 64) > 0).float()
        up = nn.Upsample(size=(128,128), mode='bilinear')
        img = up(img.unsqueeze(0)).squeeze(0)
        msk = nn.Upsample(size=(128,128), mode='nearest')(msk.unsqueeze(0)).squeeze(0)
        return img, msk

data = RandomMRIDataset()
loader = DataLoader(data, batch_size=8, shuffle=True)

class SimpleCNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.c1 = nn.Conv2d(1, 16, 3, padding=1)
        self.c2 = nn.Conv2d(16, 32, 3, padding=1)
        self.r = nn.ReLU()
        self.p = nn.MaxPool2d(2)
        self.f = nn.Flatten()
        self.fc = nn.Linear(32*32*32, 1)
        self.s = nn.Sigmoid()

    def forward(self, x):
        x = self.r(self.c1(x))
        x = self.p(x)
        x = self.r(self.c2(x))
        x = self.p(x)
        x = self.f(x)
        x = self.s(self.fc(x))
        return x

def conv_block(a, b):
    return nn.Sequential(
        nn.Conv2d(a, b, 3, padding=1),
        nn.ReLU(),
        nn.Conv2d(b, b, 3, padding=1),
        nn.ReLU()
    )

class MiniUNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.e1 = conv_block(1, 16)
        self.p = nn.MaxPool2d(2)
        self.e2 = conv_block(16, 32)
        self.u = nn.Upsample(scale_factor=2, mode='bilinear')
        self.d1 = conv_block(32, 16)
        self.o = nn.Conv2d(16, 1, 1)

    def forward(self, x):
        x = self.e1(x)
        x = self.p(x)
        x = self.e2(x)
        x = self.u(x)
        x = self.d1(x)
        x = self.o(x)
        return x

def dice_loss(p, t):
    p = p.view(-1)
    t = t.view(-1)
    i = (p*t).sum()
    return 1 - (2*i)/(p.sum() + t.sum() + 1e-6)

model = SimpleCNN()
loss_fn = nn.BCELoss()
opt = optim.Adam(model.parameters(), lr=0.001)

loss_vals = []

for e in range(3):
    for imgs, msks in loader:
        opt.zero_grad()
        out = model(imgs)
        loss = loss_fn(out, torch.zeros_like(out))
        loss.backward()
        opt.step()
        loss_vals.append(loss.item())
    print("epoch", e+1, "loss", loss.item())

plt.plot(loss_vals)
plt.show()
